NODE_ENV=development
PORT=5001

# ── Database ───────────────────────────────────────────────────────────────────
MONGO_URI=mongodb://127.0.0.1:27017/lms

# ── Auth ───────────────────────────────────────────────────────────────────────
JWT_SECRET=<your-long-jwt-secret-min-16-chars>
JWT_EXPIRY=15m
REFRESH_TOKEN_SECRET=<your-refresh-token-secret-min-16-chars>
REFRESH_TOKEN_EXPIRY_DAYS=30

# ── Redis ──────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Cloudinary ────────────────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=<your-cloudinary-cloud-name>
CLOUDINARY_API_KEY=<your-cloudinary-api-key>
CLOUDINARY_API_SECRET=<your-cloudinary-api-secret>

# ── Email (SMTP) ──────────────────────────────────────────────────────────────
SMTP_HOST=<your-smtp-host>
SMTP_PORT=587
SMTP_USERNAME=<your-smtp-username>
SMTP_PASSWORD=<your-smtp-password>
SMTP_FROM_EMAIL=<your-from-email>

# ── Razorpay ──────────────────────────────────────────────────────────────────
RAZORPAY_KEY_ID=<your-razorpay-key-id>
RAZORPAY_SECRET=<your-razorpay-secret>
RAZORPAY_PLAN_ID=<your-razorpay-plan-id>
RAZORPAY_WEBHOOK_SECRET=<your-razorpay-webhook-secret>   # Required before Phase 7

# ── Frontend ──────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173

# ── Google OAuth ──────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=<your-google-client-id>

# ── Super Admin ───────────────────────────────────────────────────────────────
SUPER_ADMIN_SECURITY_CODE=<your-super-admin-security-code>

# ── Misc ──────────────────────────────────────────────────────────────────────
CONTACT_US_EMAIL=<your-contact-email>

# ── Observability (optional) ──────────────────────────────────────────────────
SENTRY_DSN=<your-sentry-dsn>

# ── Feature flags ─────────────────────────────────────────────────────────────
VIDEO_COMPLETION_THRESHOLD=90
