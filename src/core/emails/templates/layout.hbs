<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>{{subject}}</title>
  <style>
    body { font-family: 'Segoe UI', Arial, sans-serif; background:#f4f6fb; margin:0; padding:0; }
    .wrapper { max-width:600px; margin:40px auto; background:#fff; border-radius:12px; overflow:hidden; box-shadow:0 4px 24px rgba(0,0,0,.08); }
    .header { background:linear-gradient(135deg,#6c47ff 0%,#4f8ef7 100%); padding:40px 32px; text-align:center; }
    .header h1 { color:#fff; margin:0; font-size:26px; letter-spacing:-.5px; }
    .header p { color:rgba(255,255,255,.8); margin:8px 0 0; font-size:14px; }
    .body { padding:36px 32px; color:#374151; }
    .body p { line-height:1.7; margin:0 0 16px; }
    .btn { display:inline-block; background:#6c47ff; color:#fff!important; text-decoration:none; padding:12px 28px; border-radius:8px; font-weight:600; font-size:15px; margin:8px 0; }
    .footer { background:#f9fafb; padding:20px 32px; text-align:center; font-size:12px; color:#9ca3af; border-top:1px solid #e5e7eb; }
    .divider { border:none; border-top:1px solid #e5e7eb; margin:24px 0; }
  </style>
</head>
<body>
  <div class="wrapper">
    <div class="header">
      <h1>Learnify</h1>
      <p>Your Learning Journey Awaits</p>
    </div>
    <div class="body">
      {{{body}}}
    </div>
    <div class="footer">
      &copy; {{year}} Learnify. You received this email because you are registered on our platform.<br/>
      If you did not request this, please ignore this email.
    </div>
  </div>
</body>
</html>
